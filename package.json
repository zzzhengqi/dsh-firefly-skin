{
  "name": "dsh-firefly-skin",
  "version": "1.0.1",
  "type": "module",
  "description": "流萤 Firefly 皮肤：为 DeepSeek Harness Web 客户端提供「线条起笔 → 上色 → 睁眼」载入动画、夜航配色、环境萤火与重播按钮。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "firefly"
  ],
  "license": "(MIT AND CC-BY-NC-4.0)",
  "author": "zzzhengqi (https://github.com/zzzhengqi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzzhengqi/dsh-firefly-skin.git"
  },
  "homepage": "https://github.com/zzzhengqi/dsh-firefly-skin",
  "bugs": {
    "url": "https://github.com/zzzhengqi/dsh-firefly-skin/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "ASSETS-LICENSE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
